---
// Página de una sección: lista los trabajos de src/pages/posts cuyo
// frontmatter tenga `categoria` igual al slug recibido.
import Layout from "../layouts/Layout.astro";
import AppHeader from "./Header.astro";
import AppFooter from "./Footer.astro";
import { secciones, postsDe } from "../secciones";

const { slug } = Astro.props;
const seccion = secciones.find((s) => s.slug === slug)!;
const posts = postsDe(slug);
---

<Layout titulo={seccion.titulo}>
  <AppHeader />

  <main class="max-w-5xl mx-auto px-5 py-16 w-full">
    <a href="/evidencias/" class="text-sm enlace">← Todas las evidencias</a>

    <div class="mt-10 mb-12">
      <p class="font-mono text-sm text-accent">{seccion.numero}</p>
      <h1 class="mt-2 text-4xl md:text-5xl font-semibold tracking-tight">{seccion.titulo}</h1>
      <p class="mt-3 text-muted max-w-xl">{seccion.resumen}</p>
    </div>

    {posts.length === 0 && (
      <p class="border border-dashed border-line p-8 text-center text-muted">
        Todavía no hay trabajos en esta sección.
      </p>
    )}

    <ul class="border-t border-line">
      {posts.map(({ url, frontmatter }: any) => (
        <li class="border-b border-line">
          <a href={url} class="group grid grid-cols-1 sm:grid-cols-[180px_1fr] gap-5 py-6">
            <div class="border border-line bg-surface h-36 sm:h-28 overflow-hidden">
              <img src={frontmatter.image?.url} alt="" class="w-full h-full object-cover object-top" />
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-3">
                {frontmatter.tipo === "enunciado" ? (
                  <span class="font-mono text-[0.7rem] uppercase tracking-wide border border-ink px-2 py-0.5">Enunciado</span>
                ) : (
                  <span class="font-mono text-[0.7rem] uppercase tracking-wide bg-accent text-bg px-2 py-0.5">Solución</span>
                )}
                {frontmatter.pubDate && <span class="etiqueta">{frontmatter.pubDate}</span>}
              </div>
              <h2 class="mt-2 text-xl font-semibold group-hover:text-accent">{frontmatter.title}</h2>
              <p class="mt-1 text-muted leading-relaxed">{frontmatter.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <AppFooter />
</Layout>
