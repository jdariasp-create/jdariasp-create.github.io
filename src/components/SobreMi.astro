---
import { author } from '../sample'
import Titulo from './Titulo.astro'
---

<section id="sobre-mi" class="max-w-5xl mx-auto px-5 py-20 scroll-mt-6">
  <Titulo numero="01" texto="Sobre mí" />

  <div class={`mt-10 grid grid-cols-1 gap-12 ${author.video ? 'md:grid-cols-[1.5fr_1fr]' : ''}`}>
    <div class="space-y-5 leading-relaxed text-[1.05rem]">
      {author.sobreMi.map(p => <p>{p}</p>)}

      <ul class="pt-4 flex flex-wrap gap-2">
        {author.intereses.map(item => (
          <li class="font-mono text-xs border border-line px-3 py-1.5">{item}</li>
        ))}
      </ul>
    </div>

    {author.video && (
      <div>
        <p class="etiqueta mb-3">Video de presentación</p>
        <div class={`border border-line bg-ink overflow-hidden ${author.videoVertical ? 'aspect-[9/16] max-w-[340px]' : 'aspect-video'}`}>
          <iframe
            class="w-full h-full"
            src={author.video}
            title={`Video de presentación de ${author.name}`}
            frameborder="0"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}
  </div>
</section>
