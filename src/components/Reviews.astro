---
import Titulo from './Titulo.astro'

const objetivos = [
  {
    nombre: 'Modelar',
    texto: 'Aprender a leer la descripción de un negocio y representarla en un diagrama entidad–relación que muestre con claridad qué se guarda y cómo se conecta.',
  },
  {
    nombre: 'Organizar',
    texto: 'Entender por qué una tabla mal diseñada repite información y cómo dividirla para que cada dato quede en un solo lugar.',
  },
  {
    nombre: 'Consultar',
    texto: 'Expresar preguntas sobre los datos en álgebra relacional y en SQL, desde filtros sencillos hasta consultas que combinan varias tablas.',
  },
  {
    nombre: 'Construir',
    texto: 'Llevar un diseño propio a una base de datos que funcione en MySQL, probarla y documentar cada paso del proceso.',
  },
];

const herramientas = ['MySQL 8.4', 'Ubuntu', 'VirtualBox', 'draw.io', 'Notación de Peter Chen', 'Notación Barker', 'Excel', 'Git y GitHub', 'Astro'];
---

<section class="max-w-5xl mx-auto px-5 py-20">
  <Titulo numero="03" texto="Lo que buscaba aprender" />

  <ol class="mt-4">
    {objetivos.map((item, i) => (
      <li class="grid grid-cols-[3rem_1fr] md:grid-cols-[3rem_12rem_1fr] gap-x-4 gap-y-1 py-6 border-b border-line">
        <span class="font-mono text-sm text-muted pt-0.5">0{i + 1}</span>
        <strong class="font-semibold">{item.nombre}</strong>
        <p class="col-start-2 md:col-start-3 text-muted leading-relaxed">{item.texto}</p>
      </li>
    ))}
  </ol>

  <div class="mt-12">
    <p class="etiqueta mb-4">Herramientas que usé</p>
    <ul class="flex flex-wrap gap-2">
      {herramientas.map(h => <li class="font-mono text-xs border border-line bg-surface px-3 py-1.5">{h}</li>)}
    </ul>
  </div>
</section>
