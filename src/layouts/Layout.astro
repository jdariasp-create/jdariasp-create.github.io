---
import '../styles/global.css'
import { author } from '../sample'
const { titulo } = Astro.props
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={`Portafolio de ${author.materia} de ${author.name}: modelado, normalización, álgebra relacional, SQL y proyecto final.`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{titulo ? `${titulo} · ${author.nickname}` : `${author.nickname} · Portafolio ${author.materia}`}</title>
	</head>
	<body class="min-h-screen flex flex-col">
		<slot />
	</body>
</html>
